@model Postulante
@{
    ViewData["Title"] = "Nuevo postulante";
}

<h2>Nuevo postulante</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post" class="row g-3" style="max-width: 760px;">

    <h5 class="mt-2">Datos personales</h5>
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="FechaNac" class="form-label"></label>
        <input asp-for="FechaNac" class="form-control" type="date" />
        <span asp-validation-for="FechaNac" class="text-danger"></span>
    </div>

    <h5 class="mt-3">Datos académicos</h5>
    <div class="col-md-6">
        <label asp-for="NivelAcademico" class="form-label"></label>
        <select asp-for="NivelAcademico" class="form-select">
            <option value="">-- Seleccione --</option>
            <option>Técnico Superior</option>
            <option>Licenciatura</option>
            <option>Ingeniería</option>
            <option>Maestría</option>
            <option>Doctorado</option>
            <option>Otro</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="PromedioAcademico" class="form-label"></label>
        <input asp-for="PromedioAcademico" class="form-control" type="number" step="0.01" min="0" max="100" />
        <span asp-validation-for="PromedioAcademico" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="InstitucionProcedencia" class="form-label"></label>
        <input asp-for="InstitucionProcedencia" class="form-control" />
        <span asp-validation-for="InstitucionProcedencia" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TituloObtenido" class="form-label"></label>
        <input asp-for="TituloObtenido" class="form-control" />
        <span asp-validation-for="TituloObtenido" class="text-danger"></span>
    </div>

    <h5 class="mt-3">Datos laborales</h5>
    <div class="col-md-6">
        <label asp-for="EmpresaActual" class="form-label"></label>
        <input asp-for="EmpresaActual" class="form-control" />
        <span asp-validation-for="EmpresaActual" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CargoActual" class="form-label"></label>
        <input asp-for="CargoActual" class="form-control" />
        <span asp-validation-for="CargoActual" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="AniosExperiencia" class="form-label"></label>
        <input asp-for="AniosExperiencia" class="form-control" type="number" min="0" max="80" />
        <span asp-validation-for="AniosExperiencia" class="text-danger"></span>
    </div>

    <h5 class="mt-3">Cuenta de acceso</h5>
    <div class="col-md-6">
        <label asp-for="Usuario" class="form-label"></label>
        <input asp-for="Usuario" class="form-control" />
        <span asp-validation-for="Usuario" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Clave" class="form-label"></label>
        <input asp-for="Clave" class="form-control" type="password" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" class="form-select">
            <option value="POSTULANTE">POSTULANTE</option>
            <option value="ADMIN">ADMIN</option>
        </select>
    </div>

    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
