@model List<Postulante>
@{
    ViewData["Title"] = "Postulantes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Postulantes</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo postulante</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Nivel académico</th>
                <th>Institución de procedencia</th>
                <th>Cargo actual</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.NombreCompleto</td>
                    <td>@p.Usuario</td>
                    <td>@p.Email</td>
                    <td>
                        @if (p.Rol == "ADMIN")
                        {
                            <span class="badge bg-secondary">ADMIN</span>
                        }
                        else
                        {
                            <span class="badge bg-success">POSTULANTE</span>
                        }
                    </td>
                    <td>@p.NivelAcademico</td>
                    <td>@p.InstitucionProcedencia</td>
                    <td>@p.CargoActual</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar al postulante @p.NombreCompleto?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
