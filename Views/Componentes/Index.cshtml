@model List<Componente>
@{
    ViewData["Title"] = "Componentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Componentes de los programas</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo componente</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay componentes cargados. Un componente describe un módulo, materia o bloque de contenido de un programa (por ejemplo: "Fundamentos de IA" dentro de la Maestría en Ciencia de Datos).</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Componente</th>
                <th>Programa</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Nombre</td>
                    <td>@c.ProgramaNombre</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar el componente @c.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
