@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - BecasPosgrado</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body.login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(1200px 600px at 50% -10%, rgba(200, 169, 81, 0.18), transparent 60%),
                        linear-gradient(160deg, #0d1f3c 0%, #16294d 55%, #1f3760 100%);
            font-family: var(--font-body);
            padding: 1.5rem;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #fbfaf6;
            border-top: 5px solid var(--oxford-gold);
            border-radius: 8px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
            padding: 2.5rem 2.25rem 2rem;
        }

        .login-brand {
            text-align: center;
            margin-bottom: 0.25rem;
        }

        .login-brand h1 {
            font-family: var(--font-display);
            color: var(--oxford-navy);
            font-size: 1.85rem;
            margin: 0.25rem 0 0;
            letter-spacing: 0.4px;
        }

        .login-subtitle {
            text-align: center;
            color: var(--ink-muted);
            font-size: 0.92rem;
            margin-bottom: 0;
        }

        .login-card .btn-primary {
            padding: 0.6rem 0;
            font-family: var(--font-display);
            letter-spacing: 0.5px;
        }

        .login-footnote {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.78rem;
            color: var(--ink-muted);
            letter-spacing: 0.3px;
        }
    </style>
</head>
<body class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <h1>BecasPosgrado</h1>
        </div>
        <p class="login-subtitle">Sistema de gestión de becas de posgrado</p>
        <hr class="gold-divider" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="Usuario" class="form-label"></label>
                <input asp-for="Usuario" class="form-control" autofocus />
                <span asp-validation-for="Usuario" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Clave" class="form-label"></label>
                <input asp-for="Clave" class="form-control" />
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Ingresar</button>
        </form>

        <p class="login-footnote">BecasPosgrado &middot; Gestión académica de posgrado</p>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
