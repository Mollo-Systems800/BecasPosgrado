@model List<Programa>
@{
    ViewData["Title"] = "Programas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Programas</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo programa</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">Error de base de datos: @ViewBag.Error</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Área</th>
            <th>Financiamiento</th>
            <th>Descripción</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Nombre</td>
                <td><span class="badge bg-info text-dark">@p.Area</span></td>
                <td>@p.TipoFinanciamiento</td>
                <td>@p.Descripcion</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar el programa @p.Nombre?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
