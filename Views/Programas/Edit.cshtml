@model Programa
@{
    ViewData["Title"] = "Editar programa";
}

<h2>Editar programa</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" method="post" class="row g-3" style="max-width: 600px;">
    <input type="hidden" asp-for="Id" />
    <div class="col-12">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Area" class="form-label"></label>
        <select asp-for="Area" class="form-select" asp-items="@(new SelectList((string[])ViewBag.Areas))">
        </select>
        <span asp-validation-for="Area" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TipoFinanciamiento" class="form-label"></label>
        <input asp-for="TipoFinanciamiento" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
