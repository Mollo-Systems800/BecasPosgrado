@model Sede
@{
    ViewData["Title"] = "Nueva sede";
}

<h2>Nueva sede</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post" class="row g-3" style="max-width: 600px;">
    <div class="col-12">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="IdUniversidad" class="form-label">Universidad</label>
        <select asp-for="IdUniversidad" asp-items="ViewBag.Universidades" class="form-select">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="IdUniversidad" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
